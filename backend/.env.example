# Development identity provisioning. Use generated local values; never commit secrets.
DEV_TENANT_ID=
DEV_PLATFORM_TENANT_ID=
DEV_DPCS_ADMIN_EMAIL=
DEV_DPCS_ADMIN_PASSWORD=
DEV_PLATFORM_OWNER_EMAIL=
DEV_PLATFORM_OWNER_PASSWORD=
DEV_BILLING_EMAIL=
DEV_BILLING_PASSWORD=

# Visit recordings default to private local storage for development.
VISIT_RECORDING_STORAGE_PROVIDER=local
VISIT_RECORDING_STORAGE_DIR=./storage/visit_recordings
VISIT_RECORDING_MAX_UPLOAD_BYTES=262144000

# DigitalOcean Spaces (set provider=s3 and supply all values at runtime).
# Keep the bucket private. Do not commit access keys or secret keys.
VISIT_RECORDING_S3_ENDPOINT=
VISIT_RECORDING_S3_REGION=
VISIT_RECORDING_S3_BUCKET=
VISIT_RECORDING_S3_ACCESS_KEY=
VISIT_RECORDING_S3_SECRET_KEY=
