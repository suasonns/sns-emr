{
  "manifest_version": 1,
  "title": "Functional Assessment Framework v1",
  "description": "Creates a reusable, disease-agnostic Functional Assessment Framework: five standardized clinical performance/staging scales (PPS, KPS, FAST, NYHA, ECOG), each with fully interpreted score-level knowledge (display title, nurse-facing clinical meaning, functional summary, hospice interpretation, and AI summary guidance) plus visibility-rule metadata describing which active diagnosis categories should surface which scale. This is reference clinical knowledge only -- it never establishes diagnosis, prognosis, hospice eligibility, or terminal status, and it makes no schema, migration, or API changes. It reuses the existing Ontology Disease Blueprint tables exactly as prior production manifests do: a new OntologyBodySystem/OntologyDiseaseFamily/OntologyDisease container ('Functional Assessment' / 'Functional Assessment Scales' / 'Functional Assessment Framework'), one OntologyDiseaseVariant (dimension=SEVERITY_CLASS) per individual score level (45 total, never collapsed), one OntologyDiseaseFinding concept per scale (5 total) carrying the full per-level structured knowledge in its existing severity_levels JSONB column and visibility-rule/trend metadata in its existing supporting_evidence_types JSONB column, and one APPLIES_TO OntologyConceptVariantApplicability edge per score level (45 total) linking each level's variant to its scale's concept. Every concept receives an OntologyEvidenceRule with patient_fact_requires_evidence=true. The 'assessor' and 'assessment_date' fields named in the specification's DATABASE MODEL section belong to the separate, unchanged, patient-facing assessment-recording feature (the existing 'assessments' table); this PR does not touch patient records, the API, or that table -- it only builds the reference knowledge library those future recordings will point back to.",
  "source_authority": [
    "cms guidelines.pdf",
    "1.pdf",
    "DPH-18-002E-HospiceAgencies_Text.pdf",
    "Cancer-Types-NCI-08.22.2021.pdf",
    "heart disease.pdf",
    "dementia.pdf",
    "hospice_terminal_prog_non-disease_specific.pdf"
  ],
  "scope": {
    "body_system": "Functional Assessment",
    "family": "Functional Assessment Scales",
    "disease": "Functional Assessment Framework"
  },
  "new_disease": {
    "disease": "Functional Assessment Framework",
    "family": "Functional Assessment Scales",
    "disease_category": "FUNCTIONAL_ASSESSMENT_FRAMEWORK",
    "disease_type": "ASSESSMENT_TOOL",
    "disease_description": "A reusable container for standardized functional/performance assessment scale reference knowledge (PPS, KPS, FAST, NYHA, ECOG). Not a clinical disease; used only to host scale reference knowledge inside the existing Ontology Disease Blueprint schema without any migration.",
    "clinical_purpose": "Gives admission nurses, case managers, physicians, medical directors, IDG, quality/recertification reviewers, and AI evidence analysis a single source of nurse-facing clinical meaning, functional summary, hospice interpretation, and AI interpretation guidance for every score of every supported functional assessment scale, so a brand-new hospice nurse never has to leave the EMR to understand a score.",
    "hospice_relevance": "Provides trend-analysis and recertification-support material for the IDG and physician; no individual score, and no assessment scale by itself, ever establishes diagnosis, prognosis, terminal status, or hospice eligibility -- those require the complete documented clinical picture and physician judgment."
  },
  "trend_policy": {
    "storage": "Every assessment instance must be preserved; never overwrite a prior assessment.",
    "ai_may": [
      "trend scores",
      "identify decline",
      "identify improvement",
      "identify missing assessments",
      "identify missing documentation",
      "generate recertification prompts",
      "generate physician-review prompts",
      "generate narrative suggestions",
      "generate contradiction warnings"
    ],
    "ai_may_not": [
      "establish diagnosis",
      "establish prognosis",
      "establish terminal status",
      "establish hospice eligibility",
      "certify CTI",
      "certify recertification",
      "recommend medications",
      "recommend treatments"
    ],
    "trend_values": [
      "IMPROVING",
      "STABLE",
      "DECLINING"
    ],
    "trend_basis": "Trend analysis must use historical assessments only."
  },
