+        email=email,
+        full_name=email.split("@")[0],
+        role=role,
+        active=True,
+    )
+    db_session.add(user)
+    db_session.commit()
+    db_session.refresh(user)
+    _created_platform_user_ids.append(user.id)
+    return user
+
